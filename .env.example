APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
API_HOST=127.0.0.1
API_PORT=8000
TRUST_PROXY=false

DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor
DATABASE_ECHO=false
EMBEDDING_DIMENSION=1024

CORS_ORIGINS=["http://localhost:3000"]
DOCS_ENABLED=true
MAX_REQUEST_BYTES=1048576

LLM_PROVIDER=none
READINESS_TIMEOUT_SECONDS=2
